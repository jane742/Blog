---
import { db, Post, Comment, User } from '../../../db/config';
import { eq, count, desc  } from 'drizzle-orm';
import Layout from '../../layouts/Layout.astro';
import Menu from '../../components/Menu.astro';
const { user } = Astro.locals;
if (!user || user.role !== 'admin') return Astro.redirect('/');

// 1. Рейтинг статей по количеству комментариев
const topPosts = await db
  .select({
    title: Post.title,
    commentCount: count(Comment.id),
  })
  .from(Post)
  .leftJoin(Comment, eq(Post.id, Comment.postId))
  .groupBy(Post.id)
  .orderBy(desc(count(Comment.id)))
  .limit(10); // берем топ-10

// 2. Рейтинг пользователей по количеству оставленных комментариев
const topUsers = await db
  .select({
    username: User.username,
    commentCount: count(Comment.id),
  })
  .from(User)
  .leftJoin(Comment, eq(User.id, Comment.authorId))
  .groupBy(User.id)
  .orderBy(desc(count(Comment.id)))
  .limit(10);

const topViewPosts = await db.select()
  .from(Post)
  .orderBy(desc(Post.views))
  .limit(5);
---
<Layout>
  
  <Menu/>
    <style>
        .stats-grid { display:inline-block; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px;}
        .stat-card { border: 1px solid #ccc; padding: 20px; border-radius: 8px;  }
        table { width: 100%; border-collapse: collapse; }
        th, td { text-align: left; padding: 8px; border-bottom: 1px solid #aea8a8; }
    </style>
<div class="container py-2">
    <a href="/admin/dashboard">← Назад в адмиінку</a>
    <h1>Аналітика блогу</h1>
<div class=row>
        <div class="stats-grid col-4" >
        <div class="stat-card bg-transparent  bg-gradient">
            <h3>🔥 Найпопулярніші статті</h3>
            <table>
                <thead>
                    <tr class="text-primary fw-light"> <th></th>   <th class="text-primary fw-light">Стаття</th><th class="text-primary fw-light">Переглядів</th></tr>
                </thead>
                <tbody>
    {topViewPosts.map((post, index) => {
      // Вычисляем процент «популярности» относительно самого первого (топового) поста для красивой шкалы
      const maxViews = topViewPosts[0]?.views || 1;
      const percentage = Math.round(((post.views||0) / maxViews) * 100);
      return (
               <tr>  
            <td>#{index + 1}</td>
           <td> {post.title}</td>
          <td> 👀 {post.views}</td>
          <td>  <div class="progress-bar-fill" style={`width: ${percentage}%`}></div></td>
        </tr>
       
      );
    })}
                </tbody>
            </table>
        </div>
        </div>
    <div class="stats-grid col-4">
        <div class="stat-card bg-transparent  bg-gradient">
            <h3>🔥 Найбільше обговорюють</h3>
            <table>
                <thead>
                    <tr><th class="text-primary fw-light">Пост</th><th class="text-primary fw-light">Коментарів</th></tr>
                </thead>
                <tbody>
                    {topPosts.map(p => (
                        <tr>
                            <td>{p.title}</td>
                            <td><strong>{p.commentCount}</strong></td>
                        </tr>
                    ))}
                </tbody>
            </table>
        </div></div>
 <div class="stats-grid col-4">
        <div class="stat-card bg-transparenty  bg-gradient">
            <h3>🏆 Топ коментаторів</h3>
            <table>
                <thead>
                    <tr><th class="text-primary fw-light">Користувач </th><th class="text-primary fw-light">Всього коментарів</th></tr>
                </thead>
                <tbody>
                    {topUsers.map(u => (
                        <tr>
                            <td>{u.username}</td>
                            <td><strong>{u.commentCount}</strong></td>
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>
    </div>
    </div>
    </div>
</Layout>