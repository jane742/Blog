---
import { lucia } from "../auth";
import { db, User, eq } from "astro:db";
import { Scrypt } from "oslo/password";
import Layout from "../layouts/Layout.astro";
let errorMessage = "";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const username = formData.get("username");
  const password = formData.get("password");

  if (typeof username !== "string" || typeof password !== "string") {
    errorMessage = "Невірні дані";
  } else {
    // 1. Ищем пользователя в базе данных
    const existingUser = await db
      .select()
      .from(User)
      .where(eq(User.username, username))
      .get(); // .get() вернет один объект или undefined

    if (!existingUser) {
      errorMessage = "Невірне ім'я користувача або пароль";
    } else {
      // 2. Проверяем пароль
      const scrypt = new Scrypt();
      const validPassword = await scrypt.verify(
        existingUser.password_hash,
        password,
      );

      if (!validPassword) {
        errorMessage = "Невірне ім'я користувача або пароль";
      } else {
        // 3. Создаем сессию
        // В login.astro перед lucia.createSession
        console.log("ID пользователя:", existingUser.id);

        const session = await lucia.createSession(existingUser.id, {});
        const sessionCookie = lucia.createSessionCookie(session.id);

        Astro.cookies.set(
          sessionCookie.name,
          sessionCookie.value,
          sessionCookie.attributes,
        );

        return Astro.redirect("/");
      }
    }
  }
}
---

<Layout>
  <div
    class="container-fluid min-vh-100 d-flex align-items-center justify-content-center bg-light-subtle py-5">
    <div class="row w-100 justify-content-center">
      <div class="col-10 col-sm-8 col-md-6 col-lg-4">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
          <div class="bg-primary p-4 text-center text-white">
            <div class="fs-1 mb-2">👋</div>
            <h1 class="h4 fw-bold mb-1">Вхід в систему</h1>
            <p class="small text-white-50 mb-0">
              Вітаю з поверненням! Увйдіть в свій акаунт
            </p>
          </div>

          <div class="card-body p-4 p-sm-5">
            {
              errorMessage && (
                <div
                  class="alert alert-danger d-flex align-items-center gap-2 rounded-3 border-0 shadow-sm mb-4"
                  role="alert">
                  <span class="fs-5">⚠️</span>
                  <div class="small fw-medium">{errorMessage}</div>
                </div>
              )
            }

            <form
              method="post"
              class="needs-validation">
              <div class="mb-3.5">
                <label
                  for="username"
                  class="form-label fw-semibold text-secondary small">
                  Ім'я користувача
                </label>
                <div class="input-group shadow-inner rounded-3 overflow-hidden">
                  <span
                    class="input-group-text bg-white border-end-0 text-muted"
                    >👤</span
                  >
                  <input
                    type="text"
                    name="username"
                    id="username"
                    class="form-control border-start-0 ps-0 py-2.5 custom-input"
                    placeholder="Введіть ваш нікнейм"
                    required
                    autocomplete="username"
                  />
                </div>
              </div>

              <div class="mb-4">
                <label
                  for="password"
                  class="form-label fw-semibold text-secondary small">
                  Пароль
                </label>
                <div class="input-group shadow-inner rounded-3 overflow-hidden">
                  <button
                    type="button"
                    id="togglePassword"
                    class="input-group-text bg-white border-end-0 text-muted px-3"
                    title="Показати/приховати пароль"
                    style="cursor: pointer; border-right: 0;">
                    👁️
                  </button>
                  <input
                    type="password"
                    name="password"
                    id="password"
                    class="form-control border-start-0 ps-2 py-2.5 custom-input"
                    placeholder="Введіть ваш пароль"
                    required
                    autocomplete="current-password"
                  />
                </div>
              </div>

              <button
                type="submit"
                class="btn btn-primary w-100 py-2.5 rounded-3 fw-bold shadow-sm transition-all mb-4">
                Увйти →
              </button>
            </form>

            <div class="position-relative my-4 text-center">
              <hr class="text-muted opacity-25" />
              <span
                class="position-absolute top-50 start-50 translate-middle px-3 text-muted small">
                або
              </span>
            </div>

            <div class="text-center">
              <p class="text-muted small mb-0">
                Немає акаунта?
                <a
                  href="/signup"
                  class="text-decoration-none fw-medium text-primary hover-underline ms-1">
                  Зареєструватися
                </a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const togglePassword = document.getElementById("togglePassword");
    const passwordInput = document.getElementById(
      "password",
    ) as HTMLInputElement;

    if (togglePassword && passwordInput) {
      togglePassword.addEventListener("click", function () {
        const type =
          passwordInput.getAttribute("type") === "password"
            ? "text"
            : "password";
        passwordInput.setAttribute("type", type);
        this.textContent = type === "password" ? "👁️" : "🙈";
      });
    }
  </script>
</Layout>
